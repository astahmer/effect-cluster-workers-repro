{
  "name": "effect-cluster-workers-repro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:proof": "wrangler dev --persist-to .wrangler/proof-state",
    "dev:pg": "wrangler dev --config wrangler.pg.toml --port 8790 --persist-to .wrangler/pg-proof-state",
    "prove": "node scripts/prove.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.2",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
